type vcd, domain;
type vcd_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vcd);
net_domain(vcd);

set_prop(vcd, vendor_rild_prop);
set_prop(vcd, vendor_sys_default_prop);
set_prop(vcd, vendor_config_default_prop);
set_prop(vcd, vendor_persist_config_default_prop)
get_prop(vcd, vendor_diag_prop);

allow vcd self:capability { setuid };
allow vcd serial_device:chr_file rw_file_perms;
allow vcd radio_device:chr_file rw_file_perms;

# socket
allow vcd self:capability net_raw;
