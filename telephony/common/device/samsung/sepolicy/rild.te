set_prop(rild, vendor_rild_prop);

get_prop(rild, hwservicemanager_prop);
set_prop(rild, hwservicemanager_prop);

set_prop(rild, vendor_sys_default_prop);
set_prop(rild, vendor_persist_sys_default_prop);
set_prop(rild, vendor_config_default_prop);
set_prop(rild, vendor_persist_config_default_prop);
set_prop(rild, vendor_ro_config_default_prop);
get_prop(rild, system_boot_reason_prop);

allow rild vendor_telephony_log_file:dir create_dir_perms;
allow rild vendor_telephony_log_file:file create_file_perms;
allow rild proc_net:file write;
allow rild radio_device:chr_file rw_file_perms;
allow rild vendor_rild_prop:property_service set;
allow rild vendor_data_file:dir { create_dir_perms rw_dir_perms };
allow rild vendor_data_file:file { create_file_perms rw_file_perms };
allow rild vendor_slog_file:dir create_dir_perms;
allow rild vendor_slog_file:file create_file_perms;
allow rild vendor_rild_file:dir { create_dir_perms rw_dir_perms };
allow rild vendor_rild_file:file { create_file_perms rw_file_perms };
allow rild vendor_radio_file:file { r_file_perms };
allow rild vendor_radio_file:dir { r_dir_perms };

binder_call(rild, bipchmgr)
binder_call(rild, gpsd)
binder_call(rild, hal_audio_default)
binder_call(rild, hal_secure_element_default)
binder_call(rild, platform_app)
binder_call(rild, system_app)
binder_call(rild, vendor_ims_app)
binder_call(rild, vendor_rcs_app)
binder_call(rild, vendor_telephony_app)
binder_call(rild, vendor_telephony_silentlogging_app)

# for hal service
add_hwservice(rild, hal_exynos_rild_hwservice)
