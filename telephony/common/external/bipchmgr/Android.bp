cc_binary {
    name: "bipchmgr",
    header_libs: [
        "vendor_ril_headers",
        "vendor_ril_client_headers"
    ],

    init_rc: ["bipchmgr.rc"],
    srcs: [
        "bipchmgr.cpp"
    ],

    cppflags: ["-Wno-unused-parameter"],

    shared_libs: [
        "liblog",
        "libutils",
        "libcutils",
        "libdl"
    ],

    static_libs: ["librilclienthelper"],
    proprietary: true,
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        // "-Wno-error=date-time",
    ],
    tidy: true,
    tidy_checks: [
        "-*",
        "cert-*",
        "clang-analyzer-security*",
        "android-*",
    ],
    tidy_checks_as_errors: [
        "cert-*",
        "clang-analyzer-security*",
        "android-*",
    ],
    sanitize: {
        misc_undefined: [
            "unsigned-integer-overflow",
            "signed-integer-overflow",
        ],
        diag: {
            undefined: true,
        },
        cfi: true,
    },
}

