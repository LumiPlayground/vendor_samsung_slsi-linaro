cc_defaults {
    name: "fdm_defaults",
    srcs: [
        "fdm.cpp",
        "resource.cpp",
    ],
    cflags: ["-Wno-unused-parameter"],
    shared_libs: [
        "liblog",
        "libutils",
        "libhidlbase",
        "vendor.samsung_slsi.telephony.hardware.oemservice@1.0",
    ],
}

cc_library {
    name: "libfdm",
    defaults: ["fdm_defaults"],
    cflags: ["-D__FACTORY_DM_SLIB__"],
    proprietary: true,
}

cc_binary {
    name: "fdm",
    defaults: ["fdm_defaults"],
    proprietary: true,
}