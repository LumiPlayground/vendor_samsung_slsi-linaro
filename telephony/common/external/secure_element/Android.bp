cc_binary {
    name: "android.hardware.secure_element@1.2-service-uicc",
    relative_install_path: "hw",
    proprietary: true,
    init_rc: ["android.hardware.secure_element@1.2-service-uicc.rc"],
    defaults: ["hidl_defaults"],
    srcs: [
        "secureelementmain.cpp",
        "secureelement.cpp",
        "interface.cpp",
        "utils.cpp"
    ],

    header_libs: [
        "vendor_ril_headers",
        "vendor_ril_client_headers"
    ],

    shared_libs: [
        "android.hardware.secure_element@1.0",
        "android.hardware.secure_element@1.1",
        "android.hardware.secure_element@1.2",
        "libbase",
        "libcutils",
        "libhardware",
        "libhidlbase",
        "liblog",
        "libutils",
    ],

    static_libs: ["librilclienthelper"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        // "-Wno-error=date-time",
    ],
    tidy: true,
    tidy_checks: [
        "-*",
        "cert-*",
        "clang-analyzer-security*",
        "android-*",
    ],
    tidy_checks_as_errors: [
        "cert-*",
        "clang-analyzer-security*",
        "android-*",
    ],
    sanitize: {
        misc_undefined: [
            "unsigned-integer-overflow",
            "signed-integer-overflow",
        ],
        diag: {
            undefined: true,
        },
        cfi: true,
    },
}
