cc_binary {
    name: "vcd",
    header_libs: [
        "vendor_ril_headers",
        "vendor_ril_client_headers"
    ],

    init_rc: ["vcd.rc"],
    srcs: [
        "vcd.cpp",
        "utils.cpp",
        "HostAgentManager.cpp",
        "ModemProxy.cpp",
        "base/thread.cpp",
        "base/textutils.cpp",
        "base/systemproperty.cpp",
        "base/log.cpp",
    ],
    local_include_dirs: [
        "base",
    ],
    cppflags: [
        "-Wno-unused-parameter",
        "-Wall",
        "-Wextra",
        "-Werror",
        // "-Wno-error=date-time",
    ],
    shared_libs: [
        "liblog",
        "libutils",
        "libcutils",
    ],
    static_libs: ["librilclienthelper"],

    proprietary: true,

    tidy: true,
    tidy_checks: [
        "-*",
        "cert-*",
        "clang-analyzer-security*",
        "android-*",
    ],
    tidy_checks_as_errors: [
        "cert-*",
        "clang-analyzer-security*",
        "android-*",
    ],
    sanitize: {
        misc_undefined: [
            "unsigned-integer-overflow",
            "signed-integer-overflow",
        ],
        diag: {
            undefined: true,
        },
        cfi: true,
    },
}
