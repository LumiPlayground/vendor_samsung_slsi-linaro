android_app {

    name: "OemRilService",
    system_ext_specific: true,

    srcs: [
        "src/**/*.java",
        "src/**/*.aidl",
    ],

    platform_apis: true,
    certificate: "platform",
    privileged: true,

    libs: [
        "telephony-common"
    ],

    static_libs: [
        "vendor.samsung_slsi.telephony.hardware.radio-V1.0-java",
        "vendor.samsung_slsi.telephony.hardware.radio-V1.1-java",
        "vendor.samsung_slsi.telephony.hardware.radio-V1.2-java",
        "telephony-oem-static",
    ],
}
