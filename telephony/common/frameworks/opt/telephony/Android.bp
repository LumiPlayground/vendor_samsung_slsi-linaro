java_library {
    name: "exynos-telephony-common",
    installable: true,
    system_ext_specific: true,

    srcs: [
        "src/**/*.java",
        "src/**/I*.aidl",
    ],
    libs: [
        "telephony-common",
        "ims-common",
        "unsupportedappusage",
    ],

    static_libs: [
        "telephony-protos",
        "ecc-protos-lite",
    ],
}

prebuilt_etc_xml {
    name: "exynos-telephony-common.xml",
    sub_dir: "permissions",
    src: "exynos-telephony-common.xml",
    system_ext_specific: true,
}
