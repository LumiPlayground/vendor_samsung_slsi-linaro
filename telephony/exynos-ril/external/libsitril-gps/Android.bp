cc_library_shared {
    name: "libsitril-gps",
    srcs: ["SITRilGps.cpp"],
    header_libs: [
        "vendor_ril_headers",
        "vendor_ril_client_headers",
    ],
    shared_libs: [
        "liblog",
        "libutils",
    ],
    static_libs: ["librilclienthelper"],
    cflags: [
        "-Wno-unused-parameter",
        "-DANDROID_MULTI_SIM",
        "-DANDROID_SIM_COUNT_2",
    ],
    proprietary: true,
}