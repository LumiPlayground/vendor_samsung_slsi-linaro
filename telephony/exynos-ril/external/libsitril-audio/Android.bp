cc_library_headers {
    name: "vendor_rilaudioapi_headers",
    vendor: true,
    export_include_dirs: ["."],
}

cc_library {
    name: "libsitril-audio",

    header_libs: [
        "vendor_ril_headers",
        "vendor_ril_client_headers",
    ],

    srcs: [
        "rilaudioapi.cpp",
        "rilaudioimpl.cpp",
    ],

    cflags: [
        "-Wno-unused-parameter",
        "-DANDROID_MULTI_SIM",
        "-DANDROID_SIM_COUNT_2",
    ],

    shared_libs: [
        "liblog",
        "libutils",
    ],
    static_libs: ["librilclienthelper"],

    export_include_dirs: ["."],

    proprietary: true,
}
