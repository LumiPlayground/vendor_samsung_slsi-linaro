cc_library_shared {
    name: "libsitril",
    vendor: true,
    defaults: [
        "vendor_sitril_cc_defaults",
    ],

    local_include_dirs: [
        ".",
        "base/",
        "core/",
        "core/service/",
        "core/service/common",
        "core/service/emergency",
        "core/service/cs",
        "core/service/network",
        "core/service/ps",
        "core/service/uicc",
        "core/service/stkparser",
        "database/",
        "fw/",
        "protocol/",
        "protocol/io",
        "protocol/sit/",
        "protocol/sit/factory",
        "protocol/sit/base/",
        "protocol/sit/base/json",
        "protocol/sit/base/json/cs",
        "protocol/sit/base/json/misc",
        "protocol/sit/base/json/network",
        "protocol/sit/base/json/ps",
        "protocol/sit/base/legacy",
        "protocol/sit/base/legacy/cs",
        "protocol/sit/base/legacy/misc",
        "protocol/sit/base/legacy/network",
        "protocol/sit/base/legacy/ps",
        "protocol/sit/json/",
        "protocol/sit/json/ps",
        "protocol/sit/legacy/misc/",
        "protocol/sit/legacy/network/",
        "protocol/sit/legacy/ps",
        "protocol/sit/ps/",
        "protocol/test/",
        "oem/",
        "simRecord/",
        "stk/",
        "util/",
    ],

    srcs: [
        "libril.cpp",
        ":basefiles",
        ":corefiles",
        ":fwfiles",
        ":modelfiles",
        ":protocolfiles",
        ":simrecordfiles",
        ":stkfiles",
        ":stkparserfiles",
        ":utilfiles",
        ":carrierconfigfiles",
    ],

    shared_libs: [
        "libbase",
        "liblog",
        "libutils",
        "libcutils",
        "libsqlite",
        "libjsoncpp",
        "libcrypto",
        "libhardware_legacy",
        "libnetutils",
        "librilutils",
        "libxml2",
    ],

    static_libs: [
        "libprotobuf-c-nano-enable_malloc-32bit",
        "librilvendorutils",
    ],

    header_libs: ["vendor_ril_headers"],

    // error: comparison of address of 'this->mReq_header' not equal to a null pointer is always true [-Werror,-Wtautological-pointer-compare]
    cflags: [
        "-DPB_FIELD_32BIT",
        "-DRIL_SHLIB",
        "-DRIL_FEATURE_FUNCTION_CHECK_CURRENT_STACK_BUSY",
        "-DRIL_FEATURE_NO_EXTENTION_USSD_DCS",
        "-Wno-date-time",
        "-Wall",
        "-Wextra",
        "-Werror",
        // "-Wno-error=date-time",
    ],

    tidy: true,
    tidy_checks: [
        "-*",
        "cert-*",
        "clang-analyzer-security*",
        "android-*",
    ],
    // exclude list
    // warning: declaration uses identifier '_*', which is reserved in the global namespace [cert-dcl37-c,cert-dcl51-cpp]
    // TBD: below warning is reasonable, need to change code
    // warning: using declarations in the global namespace in headers are prohibited [google-global-names-in-headers]
    // warning: 'fscanf' used to convert a string to an unsigned integer value, but function will not report conversion errors; consider using 'strtoul' instead [cert-err34-c]
    // using namespace std;
    // error: do not define a C-style variadic function; consider using a function parameter pack or currying instead [cert-dcl50-cpp,-warnings-as-errors]
    // error: operator=() does not handle self-assignment properly [cert-oop54-cpp,-warnings-as-errors]
    // error: prefer pipe2() with O_CLOEXEC to avoid leaking file descriptors to child processes [android-cloexec-pipe,-warnings-as-errors]
    // error: Call to function 'strcpy' is insecure as it does not provide bounding of the memory buffer. Replace unbounded copy functions with analogous functions that support length arguments such as 'strlcpy'. CWE-119 [clang-analyzer-security.insecureAPI.strcpy,-warnings-as-errors]^
    tidy_checks_as_errors: [
        "cert-*",
        "clang-analyzer-security*",
        "android-*",
    ],
}
