soong_config_module_type_import {
    from: "vendor/samsung_slsi/telephony/exynos-ril/Android.bp",
    module_types: ["vendor_ril_feature_cc_defaults"],
}

vendor_ril_feature_cc_defaults {
    name: "vendor_sitril_cc_defaults",
    soong_config_variables: {
        multisim: {
            cflags: [
                "-DANDROID_MULTI_SIM",
                "-DANDROID_SIM_COUNT_2",
            ],
        },
        support_nr: {
            cflags: [
                "-DSUPPORT_NR",
            ],
        },
        disable_emulate_ims_permanent_failure: {
            cflags: [
                "-DDISABLE_EMULATE_IMS_PERMANENT_FAILURE"
            ],
        },
        auto_verify_pin_with_cp: {
            cflags: [
                "-DAUTO_VERIFY_PIN_WITH_CP"
            ],
        },
    },
}

