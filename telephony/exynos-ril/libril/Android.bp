soong_config_module_type_import {
    from: "vendor/samsung_slsi/telephony/exynos-ril/Android.bp",
    module_types: ["vendor_ril_feature_cc_defaults"],
}

vendor_ril_feature_cc_defaults {
    name: "vendor_libril_cc_defaults",
    soong_config_variables: {
        multisim: {
            cflags: [
                "-DANDROID_SIM_COUNT_2",
                "-DANDROID_MULTI_SIM",
            ],
        },
        use_radio_hal_1_6: {
            cflags: [
                "-D__RADIO_HAL_V1_6__",
            ],
            shared_libs: [
                "android.hardware.radio@1.6",
            ],
            srcs: [
                "hidl/ril_service_1_6.cpp",
                // hidl/1.6
                "hidl/1.6/radio_indication_1_6.cpp",
                "hidl/1.6/radio_response_1_6.cpp",
                "hidl/1.6/modem/hidlhalresponse_modem.cpp",
                "hidl/1.6/data/hidlhalresponse_data.cpp",
                "hidl/1.6/data/hidlhalindication_data.cpp",
                "hidl/1.6/sim/hidlhalresponse_sim.cpp",
                "hidl/1.6/sim/hidlhalindication_sim.cpp",
                "hidl/1.6/network/hidlhalresponse_network.cpp",
                "hidl/1.6/network/hidlhalindication_network.cpp",
                "hidl/1.6/messaging/hidlhalresponse_messaging.cpp",
                "hidl/1.6/voice/hidlhalresponse_voice.cpp",
            ],
        },
        use_radio_hal_2_0: {
            cflags: [
                "-D__RADIO_HAL_AIDL__",
            ],
            shared_libs: [
                "android.hardware.radio@1.6",
                "libril-aidl",
                "libbase",
                "android.hardware.radio.config-V1-ndk",
                "android.hardware.radio.data-V1-ndk",
                "android.hardware.radio.messaging-V1-ndk",
                "android.hardware.radio.modem-V1-ndk",
                "android.hardware.radio.network-V1-ndk",
                "android.hardware.radio.sim-V1-ndk",
                "android.hardware.radio.voice-V1-ndk",
                "libbinder_ndk",
            ],
            srcs: [
                "hidl/ril_service_1_6.cpp",
                // hidl/1.6
                "hidl/1.6/radio_indication_1_6.cpp",
                "hidl/1.6/radio_response_1_6.cpp",
                "hidl/1.6/modem/hidlhalresponse_modem.cpp",
                "hidl/1.6/data/hidlhalresponse_data.cpp",
                "hidl/1.6/data/hidlhalindication_data.cpp",
                "hidl/1.6/sim/hidlhalresponse_sim.cpp",
                "hidl/1.6/sim/hidlhalindication_sim.cpp",
                "hidl/1.6/network/hidlhalresponse_network.cpp",
                "hidl/1.6/network/hidlhalindication_network.cpp",
                "hidl/1.6/messaging/hidlhalresponse_messaging.cpp",
                "hidl/1.6/voice/hidlhalresponse_voice.cpp",
                // aidl-service
                "aidl-service/rilaidlservicemanager.cpp",
                "aidl-service/commonStructs.cpp",
                "aidl-service/commonvendorstructs.cpp",
                "aidl-service/basecommand.cpp",
                // aidl-service/config
                "aidl-service/config/hook/commandsinfo_config.cpp",
                "aidl-service/config/hook/indicationhook.cpp",
                "aidl-service/config/hook/requesthook.cpp",
                "aidl-service/config/hook/responsehook.cpp",
                "aidl-service/config/hook/structs.cpp",
                "aidl-service/config/commands.cpp",
                "aidl-service/config/radioconfigproxy.cpp",
                "aidl-service/config/radioconfigservice.cpp",
                "aidl-service/config/vendorstructs.cpp",
                // aidl-service/modem
                "aidl-service/modem/hook/requesthook.cpp",
                "aidl-service/modem/hook/responsehook.cpp",
                "aidl-service/modem/hook/indicationhook.cpp",
                "aidl-service/modem/hook/commandsinfo_modem.cpp",
                "aidl-service/modem/hook/structs.cpp",
                "aidl-service/modem/commands.cpp",
                "aidl-service/modem/radiomodemproxy.cpp",
                "aidl-service/modem/radiomodemservice.cpp",
                "aidl-service/modem/vendorstructs.cpp",
                // aidl-service/sim
                "aidl-service/sim/hook/requesthook.cpp",
                "aidl-service/sim/hook/responsehook.cpp",
                "aidl-service/sim/hook/indicationhook.cpp",
                "aidl-service/sim/hook/commandsinfo_sim.cpp",
                "aidl-service/sim/hook/structs.cpp",
                "aidl-service/sim/commands.cpp",
                "aidl-service/sim/radiosimproxy.cpp",
                "aidl-service/sim/radiosimservice.cpp",
                "aidl-service/sim/vendorstructs.cpp",
                "aidl-service/data/hook/requesthook.cpp",
                "aidl-service/data/hook/responsehook.cpp",
                "aidl-service/data/hook/indicationhook.cpp",
                "aidl-service/data/hook/commandsinfo_data.cpp",
                "aidl-service/data/hook/structs.cpp",
                "aidl-service/data/commands.cpp",
                "aidl-service/data/radiodataproxy.cpp",
                "aidl-service/data/radiodataservice.cpp",
                "aidl-service/data/vendorstructs.cpp",
                "aidl-service/network/hook/requesthook.cpp",
                "aidl-service/network/hook/responsehook.cpp",
                "aidl-service/network/hook/indicationhook.cpp",
                "aidl-service/network/hook/commandsinfo_network.cpp",
                "aidl-service/network/hook/structs.cpp",
                "aidl-service/network/commands.cpp",
                "aidl-service/network/radionetworkproxy.cpp",
                "aidl-service/network/radionetworkservice.cpp",
                "aidl-service/network/vendorstructs.cpp",
                // aidl-service/messaging
