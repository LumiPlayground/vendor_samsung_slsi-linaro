                "aidl-service/messaging/hook/indicationhook.cpp",
                "aidl-service/messaging/hook/commandsinfo_messaging.cpp",
                "aidl-service/messaging/hook/structs.cpp",
                "aidl-service/messaging/commands.cpp",
                "aidl-service/messaging/radiomessagingproxy.cpp",
                "aidl-service/messaging/radiomessagingservice.cpp",
                "aidl-service/messaging/vendorstructs.cpp",
                // aidl-service/voice
