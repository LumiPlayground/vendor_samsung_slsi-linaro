genrule {
    name: "version_info_exynos_ril",
    cmd: "export ANDROID_BUILD_TOP=$$(pwd) && $(location gen_version_info.sh) < $(in) > $(out)",
    srcs: ["version_info_defs.h.in"],
    out: ["version_info_exynos_ril.txt"],
    tool_files: ["gen_version_info.sh"],
}

prebuilt_etc {
    name: "version_info_exynos_ril_etc",
    src: ":version_info_exynos_ril",
    soc_specific: true,
    filename: "version_info_exynos_ril.txt",
}
