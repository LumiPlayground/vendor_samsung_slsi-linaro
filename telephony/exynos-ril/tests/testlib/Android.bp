// testlib
cc_defaults {
    name: "libvendortestbase_cc_defaults",
    srcs: [
        "modemdatabuilder.cpp",
        "testutils.cpp",
    ],

    export_include_dirs: ["."],

    shared_libs: [
        "libjsoncpp",
        "libsitril",
        "libcutils",
    ],

    include_dirs: [
        "vendor/samsung_slsi/telephony/exynos-ril/libril/hidl",
        "vendor/samsung_slsi/telephony/exynos-ril/sitril",
        "vendor/samsung_slsi/telephony/exynos-ril/sitril/base",
        "vendor/samsung_slsi/telephony/exynos-ril/sitril/core",
        "vendor/samsung_slsi/telephony/exynos-ril/sitril/oem",
        "vendor/samsung_slsi/telephony/exynos-ril/sitril/protocol",
        "vendor/samsung_slsi/telephony/exynos-ril/sitril/protocol/sit",
    ],
    header_libs: ["vendor_ril_headers"],
    static_libs: ["librilvendorutils"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    sanitize: {
        misc_undefined: ["integer"],
    },
    tidy: false,
    tidy_checks: [
        "-*",
        "cert-*",
        "clang-analyzer-security*",
        "android-*",
    ],
}

cc_library_static {
    name: "libvendortestbase",
    defaults: [
        "libvendortestbase_cc_defaults",
    ],
    proprietary: true,
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    sanitize: {
        address: true,
        misc_undefined: ["integer"],
    },
    tidy: false,
    tidy_checks: [
        "-*",
        "cert-*",
        "clang-analyzer-security*",
        "android-*",
    ],
}
