// SitProtocolTests
cc_defaults {
    name: "sitprotocoltests_cc_defaults",
    srcs: [
        "protocoljsontestadapter.cpp",
        "protocoladapter_test.cpp",
        "protocolbuilder_test.cpp",
        "protocolmiscbuilderlegacy_test.cpp",
        "protocolmiscadapterlegacy_test.cpp",
        "protocolmiscadapterjson_test.cpp",
        "protocolmiscbuilderjson_test.cpp",
        "protocolsoundadapterlegacy_test.cpp",
        "protocolsoundadapterjson_test.cpp",
        "protocolsoundbuilderlegacy_test.cpp",
        "protocolsoundbuilderjson_test.cpp",
        "protocolsapadapterlegacy_test.cpp",
        "protocolsapadapterjson_test.cpp",
        "protocolsapbuilderlegacy_test.cpp",
        "protocolsapbuilderjson_test.cpp",
        "protocolnetadapterlegacy_test.cpp",
        "protocolnetadapterjson_test.cpp",
        "protocolnetadapter_cellinfo_test.cpp",
        "protocolnetbuilderlegacy_test.cpp",
        "protocolnetbuilderjson_test.cpp",
        "protocolpsadapterlegacy_test.cpp",
        "protocolpsadapterjson_test.cpp",
        "protocolpsbuilderlegacy_test.cpp",
        "protocolpsbuilderjson_test.cpp",
        "netprotocolutils_test.cpp",
        "protocolimsadapter_test.cpp",
        "protocolimsbuilder_test.cpp",
        "protocolgpsadapter_test.cpp",
        "protocolgpsbuilder_test.cpp",
        "protocolcallbuilderjson_test.cpp",
        "protocolcalladapterlegacy_test.cpp",
        "protocolcalladapterjson_test.cpp",
        "protocolsimbuilderjson_test.cpp",
        "protocolsimbuilderlegacy_test.cpp",
        "protocolsimadapterjson_test.cpp",
        "protocolsimadapterlegacy_test.cpp",
        "protocolradioconfigbuilderjson_test.cpp",
        "protocolradioconfigadapterjson_test.cpp",
        "protocolstkbuilderjson_test.cpp",
        "protocolstkadapterjson_test.cpp",
        "protocolvsimbuilderjson_test.cpp",
        "protocolvsimadapterjson_test.cpp",
        "protocolsmsbuilderjson_test.cpp",
        "protocolsmsadapterjson_test.cpp",
        "protocolembmsbuilderjson_test.cpp",
        "protocolembmsadapterjson_test.cpp",
        "protocolpsutils_test.cpp",
        "protocolutils_test.cpp",
        "protocolimsmediaadapter_test.cpp",
        "protocolimsmediabuilder_test.cpp",
        "protocolmiscadapter_test.cpp",
    ],

    // test-targeted library
    shared_libs: [
        "libjsoncpp",
        "libsitril",
        "librilutils",
        "libcutils",
        "liblog",
    ],

    static_libs: [
        "librilvendorutils",
        "libvendortestbase",
    ],

    header_libs: ["vendor_ril_headers"],
    include_dirs: [
        "vendor/samsung_slsi/telephony/exynos-ril/sitril",
        "vendor/samsung_slsi/telephony/exynos-ril/sitril/base",
        "vendor/samsung_slsi/telephony/exynos-ril/sitril/core",
        "vendor/samsung_slsi/telephony/exynos-ril/sitril/core/service",
        "vendor/samsung_slsi/telephony/exynos-ril/sitril/fw",
        "vendor/samsung_slsi/telephony/exynos-ril/sitril/oem",
        "vendor/samsung_slsi/telephony/exynos-ril/sitril/protocol",
        "vendor/samsung_slsi/telephony/exynos-ril/sitril/protocol/sit",
        "vendor/samsung_slsi/telephony/exynos-ril/sitril/protocol/sit/base",
        "vendor/samsung_slsi/telephony/exynos-ril/sitril/protocol/sit/json",
        "vendor/samsung_slsi/telephony/exynos-ril/sitril/protocol/sit/ps",
        "vendor/samsung_slsi/telephony/exynos-ril/sitril/util",
    ],

    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    tidy: false,
    tidy_checks: [
        "-*",
        "cert-*",
        "clang-analyzer-security*",
        "android-*",
    ],
}

cc_test {
    name: "SitProtocolTests",

    defaults: [
        "sitprotocoltests_cc_defaults",
    ],
    srcs: [
        "asan_options.cpp",
    ],
    sanitize: {
        misc_undefined: ["integer"],
        address : true,
        diag: {
            misc_undefined: ["integer"],
        },
    },

    proprietary: true,
}

cc_test_library {
    name: "libsitprotocoltests",
    vendor: true,

    defaults: [
        "sitprotocoltests_cc_defaults",
    ],
}
