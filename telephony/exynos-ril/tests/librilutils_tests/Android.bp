soong_config_module_type_import {
    from: "vendor/samsung_slsi/telephony/exynos-ril/Android.bp",
    module_types: ["vendor_ril_feature_cc_defaults"],
}

vendor_ril_feature_cc_defaults {
    name: "librilutils_tests_cc_defaults",
    srcs: [
        "radio_hal_utils_test.cpp",
        "radio_hal_utils_test_api.cpp",
        "radio_conv_utils_test.cpp",
        "vendor_test.cpp",
    ],
    shared_libs: [
        "liblog",
        "libutils",
        "libcutils",
        "librilutils",
        "libhidlbase",
        "android.hardware.radio@1.0",
        "android.hardware.radio@1.1",
        "android.hardware.radio@1.2",
        "android.hardware.radio@1.3",
        "android.hardware.radio@1.4",
        "android.hardware.radio@1.5",
        "vendor.samsung_slsi.telephony.hardware.radio@1.0",
        "vendor.samsung_slsi.telephony.hardware.radio@1.1",
        "vendor.samsung_slsi.telephony.hardware.radio@1.2",
    ],
    whole_static_libs: [
        "librilvendorutils",
        "librilvendorhalutils",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    header_libs: ["vendor_ril_headers"],
    soong_config_variables: {
        use_radio_hal_1_6: {
            cflags: [
                "-D__RADIO_HAL_V1_6__",
            ],
            shared_libs: [
                "android.hardware.radio@1.6",
            ],
            srcs: [
                "radio_hal_utils_1_6_test.cpp",
            ],
        },
        use_radio_hal_2_0: {
            cflags: [
                "-D__RADIO_HAL_V2_0__",
            ],
            shared_libs: [
                "android.hardware.radio@1.6",
            ],
            srcs: [
                "radio_hal_utils_1_6_test.cpp",
            ],
        },
    },

    tidy: false,
    tidy_checks: [
        "-*",
        "cert-*",
        "clang-analyzer-security*",
        "android-*",
    ],
}

cc_test {
    name: "librilutils_tests",
    defaults: [
        "librilutils_tests_cc_defaults",
    ],
    srcs: [
        "asan_options.cpp",
    ],
    sanitize: {
        misc_undefined: ["integer"],
        address : true,
        diag: {
            misc_undefined: ["integer"],
        },
    },
    proprietary: true,
}

cc_test_library {
    name: "librilutils_tests_static",
    defaults: [
        "librilutils_tests_cc_defaults",
    ],
    vendor: true,
}
