soong_config_module_type_import {
    from: "vendor/samsung_slsi/telephony/exynos-ril/Android.bp",
    module_types: ["vendor_ril_feature_cc_defaults"],
}

// libril_tests
vendor_ril_feature_cc_defaults {
    name: "libril-aidl_tests_cc_defaults",
    shared_libs: [
        "libril_sitril",
        "libutils",
        "libcutils",
        "liblog",
    ],
    static_libs: [
        "libvendortestbase",
        "librilvendorhalutils",
    ],
    include_dirs: [
        "vendor/samsung_slsi/telephony/exynos-ril/libril-aidl",
    ],
    header_libs: ["vendor_ril_headers"],
    soong_config_variables: {
        multisim: {
            cflags: [
                "-DANDROID_SIM_COUNT_2",
                "-DANDROID_MULTI_SIM",
            ],
        },
        use_radio_hal_2_0: {
            cflags: [
                "-D__RADIO_HAL_AIDL__",
            ],
            shared_libs: [
                "libril-aidl",
                "libbase",
                "android.hardware.radio.data-V1-ndk",
                "android.hardware.radio.messaging-V1-ndk",
                "android.hardware.radio.modem-V1-ndk",
                "android.hardware.radio.network-V1-ndk",
                "android.hardware.radio.sim-V1-ndk",
                "android.hardware.radio.voice-V1-ndk",
                "libbinder_ndk",
            ],
            srcs: [
                "radioconfigcallbackadapter_test.cpp",
                "radiodatacallbackadapter_test.cpp",
                "radiomessagingcallbackadapter_test.cpp",
                "radiomodemcallbackadapter_test.cpp",
                "radionetworkcallbackadapter_test.cpp",
                "radiosimcallbackadapter_test.cpp",
                "radiovoicecallbackadapter_test.cpp",
            ],
        },
    },

    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    sanitize: {
        misc_undefined: ["integer"],
    },
    tidy: false,
    tidy_checks: [
        "-*",
        "cert-*",
        "clang-analyzer-security*",
        "android-*",
    ],
}

cc_test {
    name: "libril-aidl_tests",
    defaults: [
        "libril-aidl_tests_cc_defaults",
    ],
    sanitize: {
        misc_undefined: ["integer"],
        address : true,
        diag: {
            misc_undefined: ["integer"],
        },
    },
    proprietary: true,
}

cc_test_library {
    name: "libril-aidl_tests_static",
    vendor: true,
    defaults: [
        "libril-aidl_tests_cc_defaults",
    ],
}
