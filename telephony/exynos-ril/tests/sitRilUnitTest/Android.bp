soong_config_module_type_import {
    from: "vendor/samsung_slsi/telephony/exynos-ril/Android.bp",
    module_types: ["vendor_ril_feature_cc_defaults"],
}

vendor_ril_feature_cc_defaults {
    name: "sitriltest_cc_defaults",
    soong_config_variables: {
        multisim: {
            cflags: [
                "-DANDROID_SIM_COUNT_2",
                "-DANDROID_MULTI_SIM",
            ],
        },
        use_radio_hal_1_6: {
            cflags: [
                "-D__RADIO_HAL_V1_6__",
            ],
            shared_libs: [
                "android.hardware.radio@1.6",
            ],
        },
        use_radio_hal_2_0: {
            cflags: [
                "-D__RADIO_HAL_AIDL__",
            ],
            shared_libs: [
                "android.hardware.radio@1.6",
                // aidl
                "libril-aidl",
                "libbase",
                "android.hardware.radio.data-V1-ndk",
                "android.hardware.radio.messaging-V1-ndk",
                "android.hardware.radio.modem-V1-ndk",
                "android.hardware.radio.network-V1-ndk",
                "android.hardware.radio.sim-V1-ndk",
                "android.hardware.radio.voice-V1-ndk",
                "libbinder_ndk",
            ],
        },
    },
}

cc_test {
    name: "SitrilTest",
    defaults: ["sitriltest_cc_defaults"],
    srcs: [
        "targetTest.cpp",
        "testUtil.cpp",
        "sitrilTest.cpp",
        "sitrilTestRadioPower.cpp",
        "sitrilTestNetwork.cpp",
        "sitrilTestCs.cpp",
        "sitrilTestSupp.cpp",
        "sitrilTestPs.cpp",
        "sitrilTestSim.cpp",
        "sitrilTestSms.cpp",
        "sitrilTestMisc.cpp",
        "sitrilTestMiscOem.cpp",
        "sitrilTestIms.cpp",
        "sitrilTestGps.cpp",
        "sitrilTestVsim.cpp",
        "sitrilTestAudio.cpp",
        "sitrilTestEmbms.cpp",
        "sitrilTestUtil.cpp",
        "sitrilTestSap.cpp",
        "sitrilExternTest.cpp",
        "sitrilExternTestAudio.cpp",
        "sitrilExternTestGps.cpp",
        "sitrilTestImsMedia.cpp",
    ],

    shared_libs: [
        "libdl",
        "libjsoncpp",
        "libutils",
        "libcutils",
        "libsitril",
        "librilutils",
        "libril_sitril",
        "liblog",
        "libhidlbase",
        "android.hardware.radio@1.0",
        "android.hardware.radio@1.1",
        "android.hardware.radio@1.2",
        "android.hardware.radio@1.3",
        "android.hardware.radio@1.4",
        "android.hardware.radio@1.5",
        "android.hardware.radio.config@1.0",
        "android.hardware.radio.config@1.1",
        "android.hardware.radio.config@1.2",
        "vendor.samsung_slsi.telephony.hardware.radio@1.0",
        "vendor.samsung_slsi.telephony.hardware.radio@1.1",
        "vendor.samsung_slsi.telephony.hardware.radio@1.2",
        "vendor.samsung_slsi.telephony.hardware.radioExternal@1.0",
        "vendor.samsung_slsi.telephony.hardware.radioExternal@1.1",
    ],

    static_libs: [
        "libprotobuf-c-nano-enable_malloc-32bit",
        "libvendortestbase",
    ],

    whole_static_libs: [
        "libsitprotocoltests",
        "librildatatests",
        "libservicehandlertests",
        "librilutils_tests_static",
        "libril_tests_static",
        "libril-aidl_tests_static",
        "psservice_tests_static",
    ],

    include_dirs: [
        "vendor/samsung_slsi/telephony/exynos-ril/tests/sitRilUnitTest",
        "vendor/samsung_slsi/telephony/exynos-ril/external",
        "vendor/samsung_slsi/telephony/exynos-ril/libril/hidl",
        "vendor/samsung_slsi/telephony/exynos-ril/sitril",
        "vendor/samsung_slsi/telephony/exynos-ril/sitril/fw",
        "vendor/samsung_slsi/telephony/exynos-ril/sitril/base",
        "vendor/samsung_slsi/telephony/exynos-ril/sitril/core",
        "vendor/samsung_slsi/telephony/exynos-ril/sitril/fw",
        "vendor/samsung_slsi/telephony/exynos-ril/sitril/oem",
        "vendor/samsung_slsi/telephony/exynos-ril/sitril/util",
        "vendor/samsung_slsi/telephony/exynos-ril/sitril/protocol/sit",
        "external/nanopb-c",
    ],

    proprietary: true,

    cflags: [
        "-DPB_FIELD_32BIT",
        "-DSUPPORT_CDMA",
        "-DRIL_SHLIB",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],

    header_libs: ["vendor_ril_headers"],
    /*
    sanitize: {
        misc_undefined: ["integer"],
        diag: {
            misc_undefined: ["integer"],
        },
    },
    */
    tidy: false,
    tidy_checks: [
        "-*",
        "cert-*",
        "clang-analyzer-security*",
        "android-*",
    ],
}
