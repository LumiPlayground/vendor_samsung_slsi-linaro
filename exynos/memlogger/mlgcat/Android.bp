cc_binary {
    name: "mlgcat",
    init_rc: ["mlgcat.rc"],
    srcs: [
        "mlgcat.cpp",
    ],

    include_dirs: [
        "system/core/include",
	"system/libbase/include",
    ],

    cflags: ["-Wno-unused-parameter"],
    cppflags: [
        "-std=c++17",
    ],
    shared_libs: [
        "liblog",
        "libutils",
        "libcutils",
    ],
    proprietary: true,
}
