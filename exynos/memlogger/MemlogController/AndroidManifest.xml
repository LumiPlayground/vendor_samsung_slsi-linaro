<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.samsung.slsi.exynos.memlogcontroller"
    android:sharedUserId="android.uid.system" >

    <uses-sdk
        android:minSdkVersion="28"
        android:targetSdkVersion="30" />

    <protected-broadcast android:name="com.samsung.slsi.gnss.action.START_LOGGING" />
    <protected-broadcast android:name="com.samsung.slsi.gnss.action.STOP_LOGGING" />

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MOUNT_UNMOUNT_FILESYSTEM" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:theme="@style/AppTheme" >

        <activity
            android:name=".MemlogControllerActivity"
            android:label="@string/app_name" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MemlogControllerSettings"
            android:parentActivityName=".MemlogControllerActivity" />

        <service android:name="com.samsung.slsi.exynos.memlogservice.MemlogService"/>
    </application>

</manifest>
