cc_prebuilt_library_shared {
name: "libeden_model",
    shared_libs: [
        "libc",
        "libcutils",
        "libdl",
        "libeden_osal",
        "libeden_profiler",
        "libeden_xtool",
        "liblog",
        "libm"
    ],
    multilib: {
        lib32: {
            srcs: ["lib/libeden_model.so"],
        },
        lib64: {
            srcs: ["lib64/libeden_model.so"],
        },
    },
    vendor: true,
    strip: {
        none: true,
    }
}

