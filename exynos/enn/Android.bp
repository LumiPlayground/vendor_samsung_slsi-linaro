prebuilt_etc {
    name: "public.libraries-samsung_slsi.txt",
    src: "public.libraries-samsung_slsi.txt",
    filename_from_src: true,
}

prebuilt_etc {
    name: "custom_mode_config.json",
    src: "custom_mode_config.json",
    sub_dir: "enn",
    proprietary: true,
    filename_from_src: true,
}

cc_library_headers {
    name: "enn_headers",
    host_supported: false,
    vendor: true,
    export_include_dirs: [ "include" ],
}

cc_prebuilt_library_shared {
  name : "libenn_seva_vendor",
  vendor: true,
  shared_libs: [
    "libenn_klm_vendor",
    "libenn_gc_vendor",
    "libenn_user.samsung_slsi",
    "libc++",
    "libc",
    "libdl",
    "libm",
    "liblog",
    "libutils",
    "libcutils",
  ],
  multilib:{
    lib32: {
      srcs: ["lib/libenn_seva_vendor.so"],
    },
    lib64: {
      srcs: ["lib64/libenn_seva_vendor.so"],
    },
  },
  strip: {
    none: true,
  },
}

