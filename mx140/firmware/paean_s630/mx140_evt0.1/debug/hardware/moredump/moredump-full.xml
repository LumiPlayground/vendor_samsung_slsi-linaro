-->

<!--
NOTES:
* memory region ranges and sizes will need to be revisited and confirmed/corrected at some point
* dev node names are likely to change so this file should be updated accordingly
-->

<moredump4 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.samsung.com ../Moredump4.xsd">

  <target name="paean" aka="mxl461" idat="d0000000" chipid="AB" firmware="90000000"
          comment="http://cognidox/cgi-perl/part-details?partnum=SC-509249-DD">
    <!-- Define the mmap range(s) -->
    <mmap startAddr="90000000" endAddr="907fffff" dev="/dev/mx_0_mmap"/>

    <!-- ////////////////////////////////////////////// -->
    <!--     CORTEX R7 PROCESSORS (WLAN)   //////////// -->
    <!-- ////////////////////////////////////////////// -->
    <cpu name="CortexR7P0" xml="cortexR7.xml">
      <instance t32API="20000" t32GDB="30000" dev="/dev/mx_0_wlan_gdb" subsys="WLAN" errorIfDisconnected="true">
      </instance>

      <!-- private regions -->
      <memory startAddr="00000000" endAddr="0000ffff" name="ITCM0P" comment="64KB" />
      <memory startAddr="08000000" endAddr="0800ffff" name="DTCM0P" comment="64KB" />

      <!-- regions shared by all R7s are represented as owned by R7P0 and mapped by the other ones -->
      <memory startAddr="10000000" endAddr="1000ffff" name="RAMID" comment="64KB" />
      <memory startAddr="18000000" endAddr="1800ffff" name="RAMDD" comment="64KB" />
      <memory startAddr="20000000" endAddr="2000ffff" name="RAMIP" comment="64KB" />
      <memory startAddr="28000000" endAddr="2800ffff" name="RAMDP" comment="64KB" />
      <memory startAddr="30000000" endAddr="3000ffff" name="RAMIS" comment="64KB" />
      <memory startAddr="38000000" endAddr="3800ffff" name="RAMDS" comment="64KB" />

      <!-- regions shared by R7P0, R7P1 and the M3s are represented as owned by R7P0 and mapped by the other ones -->
      <memory startAddr="68000000" endAddr="6800ffff" name="RAML2P" comment="64KB" />

      <!-- regions shared by WLAN PROCESSORS (R7s AND all or some of the M3s) are represented as owned by R7P0 and mapped by the others -->
      <memory startAddr="70000000" endAddr="7000ffff" name="RAMSD" comment="64KB" />
      <memory startAddr="78000000" endAddr="7800ffff" name="RAMSP" comment="64KB" />
      <memory startAddr="80000000" endAddr="8000ffff" name="RAMSS" comment="64KB" />

      <!-- TODO: The following subsystems should be represented the same way as the RAMS* above (owned by R7P0) and mapped by all (PERI)
        or some of the M3s (the rest), but the register definitions aren't ready yet (?) -->
      <!--<subsystem name="PERWD" xml="?.xml" comment=""/>-->
      <!--<subsystem name="PERWP" xml="?.xml" comment=""/>-->
      <!--<subsystem name="PERWS" xml="?.xml" comment=""/>-->
      <!--<subsystem name="PERI" xml="???peri_registers.xml" comment=""/>-->
    </cpu>

    <cpu name="CortexR7P1" xml="cortexR7.xml">
      <instance t32API="20001" t32GDB="30001" dev="/dev/mx_0_wlan_2_gdb" subsys="WLAN" errorIfDisconnected="true">
        <map name="RAMID" target="10000000" comment="shared with the other R7s" />
        <map name="RAMDD" target="18000000" comment="shared with the other R7s" />
        <map name="RAMIP" target="20000000" comment="shared with the other R7s" />
        <map name="RAMDP" target="28000000" comment="shared with the other R7s" />
        <map name="RAMIS" target="30000000" comment="shared with the other R7s" />
        <map name="RAMDS" target="38000000" comment="shared with the other R7s" />

        <map name="RAML2P" target="68000000" comment="shared with R7P0 and the M3s" />

        <map name="RAMSD" target="70000000" comment="shared with the other R7s and the M3s" />
        <map name="RAMSP" target="78000000" comment="shared with the other R7s and the M3s" />
        <map name="RAMSS" target="80000000" comment="shared with the other R7s and the M3s" />
      </instance>

      <!-- private regions -->
      <memory startAddr="00000000" endAddr="0000ffff" name="ITCM1P" comment="64KB" />
      <memory startAddr="08000000" endAddr="0800ffff" name="DTCM1P" comment="64KB" />
    </cpu>

    <cpu name="CortexR7S0" xml="cortexR7.xml">
      <instance t32API="20002" t32GDB="30002" dev="/dev/mx_0_wlan_3_gdb" subsys="WLAN" errorIfDisconnected="true">
        <map name="RAMID" target="10000000" comment="shared with the other R7s" />
        <map name="RAMDD" target="18000000" comment="shared with the other R7s" />
        <map name="RAMIP" target="20000000" comment="shared with the other R7s" />
        <map name="RAMDP" target="28000000" comment="shared with the other R7s" />
        <map name="RAMIS" target="30000000" comment="shared with the other R7s" />
        <map name="RAMDS" target="38000000" comment="shared with the other R7s" />

        <map name="RAMSD" target="70000000" comment="shared with the other R7s and the M3s" />
        <map name="RAMSP" target="78000000" comment="shared with the other R7s and the M3s" />
        <map name="RAMSS" target="80000000" comment="shared with the other R7s and the M3s" />
      </instance>

      <!-- private regions -->
      <memory startAddr="00000000" endAddr="0000ffff" name="ITCM0S" comment="64KB" />
      <memory startAddr="08000000" endAddr="0800ffff" name="DTCM0S" comment="64KB" />

      <!-- regions shared by R7S0, R7S1 and the M3s are represented as owned by R7S0 and mapped by the other ones -->
      <memory startAddr="68000000" endAddr="6800ffff" name="RAML2S" comment="64KB" />
    </cpu>

    <cpu name="CortexR7S1" xml="cortexR7.xml">
      <instance t32API="20003" t32GDB="30003" dev="/dev/mx_0_wlan_4_gdb" subsys="WLAN" errorIfDisconnected="true">
        <map name="RAMID" target="10000000" comment="shared with the other R7s" />
        <map name="RAMDD" target="18000000" comment="shared with the other R7s" />
        <map name="RAMIP" target="20000000" comment="shared with the other R7s" />
        <map name="RAMDP" target="28000000" comment="shared with the other R7s" />
        <map name="RAMIS" target="30000000" comment="shared with the other R7s" />
        <map name="RAMDS" target="38000000" comment="shared with the other R7s" />

        <map name="RAML2S" target="68000000" comment="shared with R7S0 and the M3s" />

        <map name="RAMSD" target="70000000" comment="shared with the other R7s and the M3s" />
        <map name="RAMSP" target="78000000" comment="shared with the other R7s and the M3s" />
        <map name="RAMSS" target="80000000" comment="shared with the other R7s and the M3s" />
      </instance>

      <!-- private regions -->
      <memory startAddr="00000000" endAddr="0000ffff" name="ITCM1S" comment="64KB" />
      <memory startAddr="08000000" endAddr="0800ffff" name="DTCM1S" comment="64KB" />
    </cpu>

    <!-- ////////////////////////////////////////////// -->
    <!--     CORTEX M3 PROCESSORS (WLAN)   //////////// -->
    <!-- ////////////////////////////////////////////// -->

    <cpu name="CortexM3" xml="cortexM3.xml">
      <instance index="0" t32API="20011" t32GDB="30011" dev="/dev/mx_0_fxm_1_gdb" subsys="WLAN">
        <!-- "mapped" memory includes regions shared within WLAN (i.e, between the R7 and the M3 instances) but not with the M7 (WPAN)-->

        <!--<map name="PERI" target="D0000000" comment="PERI shared with R7" />-->
        <!--<map name="PERWD" target="A0000000" comment="PERWD remapped at 0xA0000000" />-->
        <map name="RAMSD" target="70000000" comment="RAMSD shared with all WLAN processors" />
        <map name="RAMSD" target="78000000" comment="RAMSD mapped a second time at 7800_0000" /> <!-- a second time -->

        <map name="RAML2P" target="68000000" comment="RAML2P mapped" />
        <map name="RAML2S" target="6c000000" comment="RAML2S mapped" />
      </instance>

      <instance index="1" t32API="20012" t32GDB="30012" dev="/dev/mx_0_fxm_2_gdb" subsys="WLAN">
        <!-- "mapped" memory includes regions shared within WLAN (i.e, between the R7 and the M3 instances) but not with the M7 (WPAN)-->

        <!--<map name="PERI" target="D0000000" comment="PERI shared with R7" />-->
        <!--<map name="PERWP" target="A0000000" comment="PERWP remapped at 0xA0000000" />-->
        <map name="RAMSD" target="70000000" comment="RAMSD shared with all WLAN processors" />
        <map name="RAMSP" target="78000000" comment="RAMSP mapped at 7800_0000" />

        <map name="RAML2P" target="68000000" comment="RAML2P mapped" />
        <map name="RAML2S" target="6c000000" comment="RAML2S mapped" />
      </instance>

      <instance index="2" t32API="20013" t32GDB="30013" dev="/dev/mx_0_fxm_3_gdb" subsys="WLAN">
        <!-- "mapped" memory includes regions shared within WLAN (i.e, between the R7 and the M3 instances) but not with the M7 (WPAN)-->

        <!--<map name="PERI" target="D0000000" comment="PERI shared with R7" />-->
        <!--<map name="PERWS" target="A0000000" comment="PERWS remapped at 0xA0000000" />-->
        <map name="RAMSD" target="70000000" comment="RAMSD shared with all WLAN processors" />
        <map name="RAMSS" target="78000000" comment="RAMSS mapped at 7800_0000" />

        <map name="RAML2P" target="68000000" comment="RAML2P mapped" />
        <map name="RAML2S" target="6c000000" comment="RAML2S mapped" />
      </instance>

      <extraXml name="Nested Vectored Interrupt Controller (M3)" xml="cortexM3_nvic.xml"/>
      <extraXml name="Debug (M3)" xml="cortexM3_dbg.xml"/>
      <extraXml name="System Control Space (M3)" xml="cortexM3_scs.xml"/>
      <extraXml name="Data Watchpoint and Trace Unit (M3)" xml="cortexM3_dwt.xml"/>
      <extraXml name="Flash Patch and Breakpoint Unit (M3)" xml="cortexM3_fpb.xml"/>
      <extraXml name="Instrumentation Trace Macrocell (M3)" xml="cortexM3_itm.xml"/>
      <extraXml name="Embedded Trace Macrocell (M3)" xml="cortexM3_etm.xml"/>
    </cpu>


    <!-- ////////////////////////////////////////////// -->
    <!--     CORTEX M7 PROCESSOR (WPAN)   ///////////// -->
    <!-- ////////////////////////////////////////////// -->
    <cpu name="CortexM7" xml="cortexM7.xml">
      <instance t32API="20003" t32GDB="30003" dev="/dev/mx_0_wpan_gdb" subsys="WPAN">
        <!-- any required region mappings should go here (i.e. regions shared by some, but not all, cpu instances) -->
      </instance>

      <extraXml name="Nested Vectored Interrupt Controller (M7)" xml="cortexM7_nvic.xml"/>
      <extraXml name="System Control Space (M7)" xml="cortexM7_scs.xml"/>
      <extraXml name="Debug (M7)" xml="cortexM7_dbg.xml"/>
      <extraXml name="Data Watchpoint and Trace Unit (M7)" xml="cortexM7_dwt.xml"/>
      <extraXml name="Flash Patch and Breakpoint Unit (M7)" xml="cortexM7_fpb.xml"/>
      <extraXml name="Instrumentation Trace Macrocell (M7)" xml="cortexM7_itm.xml"/>
      <extraXml name="Memory Protection Unit (M7)" xml="cortexM7_mpu.xml"/>

      <memory startAddr="00000000" endAddr="00023fff" name="ITCM (WPAN)" comment="144KB" />
      <memory startAddr="00800000" endAddr="0093ffff" name="DRAM remapped" comment="1280KB" />
      <memory startAddr="20000000" endAddr="20023fff" name="DTCM (WPAN)" comment="144KB" />

      <subsystem name="PERB" xml="perb_registers.xml" comment=""/>
    </cpu>

    <cpu name="CortexM0+" xml="cortexM0Plus.xml">
      <!-- This definition just defines the existence of the M0+ so a moredump file can be loaded into the simulator -->
    </cpu>

    <!-- Regions defined outside a cpu node are global (accessible by all cpus at the same address(es)) -->

    <subsystem name="PERT" xml="pert_registers.xml" comment=""/>

    <subsystem name="PCIEDBI pci_aer_cap" xml="pci_aer_cap_registers.xml" comment=""/>
    <subsystem name="PCIEDBI pci_atu_cap" xml="pci_atu_cap_registers.xml" comment=""/>
    <subsystem name="PCIEDBI pci_hdma_cap" xml="pci_hdma_cap_registers.xml" comment=""/>
    <subsystem name="PCIEDBI pci_l1sub_cap" xml="pci_l1sub_cap_registers.xml" comment=""/>
    <subsystem name="PCIEDBI pci_ltr_cap" xml="pci_ltr_cap_registers.xml" comment=""/>
    <subsystem name="PCIEDBI pci_msi_cap" xml="pci_msi_cap_registers.xml" comment=""/>
    <subsystem name="PCIEDBI pci_msix_cap_dbi2" xml="pci_msix_cap_dbi2_registers.xml" comment=""/>

    <subsystem name="PCIEDBI pci_msix_cap" xml="pci_msix_cap_registers.xml" comment=""/>
    <subsystem name="PCIEDBI pci_pcie_cap_dbi2" xml="pci_pcie_cap_dbi2_registers.xml" comment=""/>
    <subsystem name="PCIEDBI pci_pcie_cap" xml="pci_pcie_cap_registers.xml" comment=""/>
    <subsystem name="PCIEDBI pci_pm_cap" xml="pci_pm_cap_registers.xml" comment=""/>
    <subsystem name="PCIEDBI pci_port_logic" xml="pci_port_logic_registers.xml" comment=""/>
    <subsystem name="PCIEDBI pci_ras_des_cap" xml="pci_ras_des_cap_registers.xml" comment=""/>
    <subsystem name="PCIEDBI pci_spcie_cap" xml="pci_spcie_cap_registers.xml" comment=""/>
    <subsystem name="PCIEDBI pci_type0_hdr_dbi2" xml="pci_type0_hdr_dbi2_registers.xml" comment=""/>
    <subsystem name="PCIEDBI pci_type0_hdr" xml="pci_type0_hdr_registers.xml" comment=""/>
    <subsystem name="PCIEDBI pci_vsecdma_cap" xml="pci_vsecdma_cap_registers.xml" comment=""/>

    <memory startAddr="60000000" endAddr="600083ff" name="RAMRP" comment="33KB" />
    <memory startAddr="90000000" endAddr="907fffff" name="PCIE" comment="8MB" />
  </target>

  <rfchips zippy="52000000"> <!-- the start address of the zippy_bb block (defined in pert.xml) -->
    <!--
       Override - if needed - the default offsets of zippy registers relative to the start address defined above.

       Currently, the register offsets that can be overridden are listed below along
       with the values that moredump will use by default otherwise
       (values are always expressed as non-prefixed hexadecimals):
           addressControlRegOffset: defaults to 0
           readDataRegOffset: 4
           interruptEnableRegOffset: 34
           interruptStatusRegOffset: 38
           interruptClearRegOffset: 3c
           apbStatusRegOffset: 40

       Moredump needs to know the addresses of these registers to perform zippy transactions to
       fetch the RF chip register contents.
    -->
    <!-- Register addresses are defined in pert_registers.xml
        addressControlReg: ZIPPY_BB_ADDR_CTRL_MPORT_I0
        readDataReg: ZIPPY_BB_READ_DATA_MPORT_I0
        interruptEnableReg: ZIPPY_BB_INT_EN_I0
        interruptStatusReg: ZIPPY_BB_INT_STATUS_I0
        interruptClearReg: ZIPPY_BB_INT_CLEAR_I0
        apbStatusRegOffset: ZIPPY_BB_APB_STATUS_I0
    -->
    <zippy
      addressControlRegOffset="10000"
      readDataRegOffset="1000c"
      interruptEnableRegOffset="38"
      interruptStatusRegOffset="3c"
      interruptClearRegOffset="40"
      apbStatusRegOffset="44"
    />
    <rfchip name="lark" idat="0000" chipid="B3" interface="zippy">
      <version majorminor="01" xml="btwl_registers.xml" comment="S621 EVT0.1"/>
    </rfchip>
    <rfchip name="leopard" idat="0000" chipid="B4" interface="zippy">
      <version majorminor="00" xml="rf_chip_registers.xml" comment="S630 EVT0"/>
    </rfchip>
  </rfchips>
</moredump4>
