soong_namespace {
}

cc_prebuilt_library_shared {
	name: "libgpudataproducer",

	compile_multilib: "both",

	owner: "samsung_arm",
	multilib: {
		lib64: {
			srcs: ["lib64/libgpudataproducer.so"],
		},
		lib32: {
			srcs: ["lib/libgpudataproducer.so"],
		},
	},
	shared_libs: [
		"libc++",
		"libc",
		"libdl",
		"libion_exynos",
		"liblog",
		"libm"
	],
	vendor: true,
	proprietary: true,
	soc_specific: true,
	check_elf_files: true,
}

cc_prebuilt_library_shared {
    name: "libFilmGrainNoise",

    compile_multilib: "both",
    soc_specific: true,

    owner: "samsung_arm",
    multilib: {
        lib64: {
            srcs: ["lib64/libFilmGrainNoise.so"],
        },
        lib32: {
            srcs: ["lib/libFilmGrainNoise.so"],
        },
    },

    check_elf_files: false,
}
