prebuilt_etc_xml {
    name: "com.shannon.qualifiednetworksservice.xml",

    src: "com.shannon.qualifiednetworksservice.xml",

    system_ext_specific: true,

    sub_dir: "permissions",
}

android_app {
    name: "ShannonQualifiedNetworksService",
    platform_apis: true,

    system_ext_specific: true,

    privileged: true,

    required: ["com.shannon.qualifiednetworksservice.xml"],

    static_libs: [
        "androidx.annotation_annotation",
        "androidx.core_core",
        "androidx.appcompat_appcompat",
    ] + ["vendor.samsung_slsi.telephony.hardware.radioExternal-V1.0-java"],

    libs: ["ims-common"] + ["telephony-common"],

    srcs: ["java/**/*.java"],

    resource_dirs: ["res"],

    aaptflags: ["--auto-add-overlay"] + [
        "--extra-packages",
        "android.support.v7.appcompat",
    ],

    manifest: ":qns-manifest-with-git-commithash",
}

genrule {
    name: "qns-manifest-with-git-commithash",
    srcs: ["AndroidManifest.xml"],
    tool_files: ["qns_version.sh"],
    out: ["AndroidManifest_WithGitCommitHash.xml"],
    cmd: "$(location qns_version.sh) $(in) $(out)",
}
