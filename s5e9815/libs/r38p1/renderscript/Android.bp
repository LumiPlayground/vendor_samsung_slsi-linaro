soong_namespace {
}

cc_prebuilt_library_shared {
    name: "libbccArm",

    compile_multilib: "64",
    vendor: true,

    owner: "samsung_arm",
    multilib: {
        lib64: {
            srcs: ["lib64/libbccArm.so"],
        },
    },
    shared_libs: [
        "libLLVM_android_mali",
        "libbcc_mali",
        "libc++",
        "libc",
        "libdl",
        "liblog",
        "libm",
    ],
}

cc_prebuilt_library_shared {
    name: "libbcc_mali",

    compile_multilib: "64",
    vendor: true,

    owner: "samsung_arm",
    multilib: {
        lib64: {
            srcs: ["lib64/libbcc_mali.so"],
        },
    },
    shared_libs: [
        "libLLVM_android_mali",
        "libbcinfo",
        "libc++",
        "libc",
        "libdl",
        "liblog",
        "libm",
    ],
}

cc_prebuilt_library_shared {
    name: "libLLVM_android_mali",

    compile_multilib: "64",
    vendor: true,

    owner: "samsung_arm",
    multilib: {
        lib64: {
            srcs: ["lib64/libLLVM_android_mali.so"],
        },
    },
    allow_undefined_symbols: true,
}

cc_prebuilt_library_shared {
    name: "libRSDriverArm",

    compile_multilib: "both",
    vendor: true,

    owner: "samsung_arm",
    multilib: {
        lib64: {
            srcs: ["lib64/libRSDriverArm.so"],
        },
        lib32: {
            srcs: ["lib/libRSDriverArm.so"],
        },
    },
    shared_libs: [
        "libRSCpuRef",
        "libRS_internal",
        "libbcinfo",
        "libc++",
        "libc",
        "libdl",
        "liblog",
        "libm",
        "libnativewindow",
    ],
}

cc_prebuilt_binary {
    name: "bcc_mali",

    compile_multilib: "64",
    vendor: true,

    owner: "samsung_arm",
    srcs: ["bin/bcc_mali"],
    shared_libs: [
	"libLLVM_android_mali",
	"libbcc_mali",
	"libbcinfo",
	"libc++",
	"liblog",
	"libvndksupport"
    ],
}
