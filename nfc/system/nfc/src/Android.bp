cc_library_static {
    name: "nfc_sec_integration_fuzzer_proto",
    owner: "samsung",
    host_supported: true,
    srcs: ["fuzzers/integration/nfc_integration_fuzzer.proto"],
    proto: {
        type: "full",
        export_proto_headers: true,
    },
    shared_libs: ["libprotobuf-cpp-full"],
}

cc_fuzz {
    name: "nfc_sec_integration_fuzzer",
    defaults: ["nfc_sec_fuzzer_defaults"],
    srcs: [
        "adaptation/debug_nfcsnoop.cc",
        "fuzzers/integration/*.cc",
        "fuzzers/integration/fakes/*.cc",
        "gki/common/gki_buffer.cc",
        "adaptation/debug_lmrt.cc",
        "nfa/ce/*.cc",
        "nfa/dm/*.cc",
        "nfa/ee/*.cc",
        "nfa/hci/*.cc",
        "nfa/p2p/*.cc",
        "nfa/rw/*.cc",
        "nfa/sys/*.cc",
        "nfc/llcp/*.cc",
        "nfc/nci/*.cc",
        "nfc/ndef/*.cc",
        "nfc/nfc/*.cc",
        "nfc/tags/*.cc",
    ],
    cflags: [
        "-DNFC_INTEGRATION_FUZZER",
    ],
    local_include_dirs: [
        "fuzzers/integration",
        "fuzzers/integration/fakes",
    ],
    static_libs: [
        "libprotobuf-mutator",
        "libutils",
        "nfc_sec_integration_fuzzer_proto",
    ],
    shared_libs: [
        "libprotobuf-cpp-full",
        "libz",
    ]
}

genrule {
    name: "NfcGeneratedPackets_sec_rust",
    tools: [
        "bluetooth_packetgen",
    ],
    cmd: "$(location bluetooth_packetgen) --include=vendor/samsung_slsi/nfc/system/nfc/src --out=$(genDir) $(in) --rust",
    srcs: [
        "nci_packets.pdl",
    ],
    out: [
        "nci_packets.rs",
    ],
}

rust_library {
    name: "libnfc_packets_sec",
    defaults: ["nfc_rust_sec_defaults"],
    crate_name: "nfc_packets",
    srcs: ["rust/packets/lib.rs", ":NfcGeneratedPackets_sec_rust"],
    host_supported: true,
    proc_macros: ["libnum_derive"],
    rustlibs: [
        "libbytes",
        "libnum_traits",
        "libthiserror",
        "liblog_rust",
    ],
}

rust_test_host {
    name: "libnfc_packets_sec_test",
    defaults: ["nfc_rust_sec_defaults"],
    srcs: ["rust/packets/lib.rs", ":NfcGeneratedPackets_sec_rust"],
    test_suites: ["general-tests"],
    proc_macros: ["libnum_derive"],
    rustlibs: [
        "libbytes",
        "libnum_traits",
        "libthiserror",
        "liblog_rust",
    ],
}
