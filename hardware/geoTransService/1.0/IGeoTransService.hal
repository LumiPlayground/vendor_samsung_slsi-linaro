package vendor.samsung_slsi.hardware.geoTransService@1.0;

interface IGeoTransService {

  /**
   * @brief
   * Run scaler
   * @param[dst] destination buffer data
   * @param[dstHndl] HIDL handle for destination buffer
   * @param[src] destination buffer data
   * @param[srcHndl] HIDL handle for source buffer
   * @param[client] HIDL client
   * @return[output] status
   */
    runCSC(BufferData dst, handle dstHndl, BufferData src, handle srcHndl, IBase client) generates (int32_t ret);

  /**
   * @brief
   * Run warper
   * @param[dst] destination buffer data
   * @param[dstHndl] HIDL handle for destination buffer
   * @param[src] destination buffer data
   * @param[srcHndl] HIDL handle for source buffer
   * @param[gridXY] grid X and Y
   * @param[client] HIDL client
   * @return[output] status
   */
    runGDC(BufferData dst, handle dstHndl, BufferData src, handle srcHndl, GDCGrid gridXY, IBase client) generates (int32_t ret);

};
