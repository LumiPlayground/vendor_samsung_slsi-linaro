<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:padding="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginRight="5dp"
                android:gravity="center"
                android:text="Directory Name" />

            <EditText
                android:id="@+id/editDir"
                style="@style/TextStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Log Directory Name"
                android:lines="1"
                android:maxLength="15"
                android:singleLine="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="30dp"
            android:background="@drawable/bg_rectangle"
            android:orientation="vertical"
            android:padding="5dp">

            <CheckBox
                android:id="@+id/logcat_checkbox"
                style="@style/TextStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:paddingLeft="10dp"
                android:text="logcat" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:background="@android:color/darker_gray" />

            <RadioGroup
                android:id="@+id/wifi_bt_RadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/wifi_radioButton"
                    style="@style/TextStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:checked="true"
                    android:paddingLeft="10dp"
                    android:text="wifi log" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingLeft="20dp">

                    <CheckBox
                        android:id="@+id/udilog"
                        style="@style/TextStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:paddingLeft="10dp"
                        android:text="udi log" />

                    <CheckBox
                        android:id="@+id/mxlog"
                        style="@style/TextStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="10dp"
                        android:text="mx log" />
                </LinearLayout>

                <RadioButton
                    android:id="@+id/bt_radioButton"
                    style="@style/TextStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:checked="false"
                    android:paddingLeft="10dp"
                    android:text="bt log" />
            </RadioGroup>

            <RadioGroup
                android:id="@+id/btFilter_RadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="20dp">

                <RadioButton
                    android:id="@+id/bt_normal"
                    style="@style/TextStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:text="general" />

                <RadioButton
                    android:id="@+id/bt_audio"
                    style="@style/TextStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:text="audio" />

                <RadioButton
                    android:id="@+id/bt_custom"
                    style="@style/TextStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="10dp"
                    android:text="custom"
                    android:textSize="18sp" />

                <LinearLayout
                    android:id="@+id/layoutCustomFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="Custom Filter" />

                    <EditText
                        android:id="@+id/editFilter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bt_default_log_filter"
                        android:lines="1"
                        android:maxLength="10"
                        android:singleLine="true" />
                </LinearLayout>
            </RadioGroup>
        </LinearLayout>

        <Button
            android:id="@+id/btnLog"
            style="@style/ButtonStyle"
            android:layout_marginTop="20dp"
            android:text="@string/start_log" />

        <android.support.design.widget.TextInputLayout
            android:id="@+id/hip4EditTextLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginHorizontal="30dp">

            <android.support.design.widget.TextInputEditText
                android:id="@+id/EditLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Input HIP4 file name"
                android:inputType="text" />
        </android.support.design.widget.TextInputLayout>

        <Button
            android:id="@+id/hip4"
            style="@style/ButtonStyle"
            android:layout_marginTop="20dp"
            android:visibility="gone"
            android:text="Save HIP4 Profiling" />

        <Button
            android:id="@+id/showChart"
            style="@style/ButtonStyle"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:visibility="gone"
            android:text="Show Chart" />
    </LinearLayout>
</ScrollView>